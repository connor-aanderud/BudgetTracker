# Base URL for the BudgetTracker API.
# Leave unset to use a relative path (`/api/v1`), which works with both:
#   - Vite dev server (proxied to VITE_API_PROXY_TARGET, default http://localhost:5000)
#   - Docker (nginx proxies /api/ to the api container)
# Set this only when the API lives at a different absolute URL.
# VITE_API_URL=http://localhost:5000/api/v1

# Where the Vite dev proxy forwards /api requests. Only used by `npm run dev`.
# VITE_API_PROXY_TARGET=http://localhost:5000
